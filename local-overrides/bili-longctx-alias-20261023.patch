# tier-distill refused (no-shrink +275) and summary dial 502 ('upstream Errno 111') in the same window.
# fix: same-model same-lane alias, contextWindow 2.6M / maxTokens 65536 (real 512K: 384+64<<512).
# switch ONLY the affected session to provider dgx-spark-glm53-exl3-ctx after host restart.
--- profiles/web/cordis.patch.yml.bak-20261023-before-longctx-alias	2026-10-23 18:47:10.597722200 +0800
