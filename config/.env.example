# oh-my-whale — 环境变量清单
# 新机部署时按此清单设置环境变量（值不进入 repo）
# 设置方式（PowerShell）: [Environment]::SetEnvironmentVariable('NAME', 'value', 'User')

# ============ dsh 模型 provider 的 API Key ============
# settings.yaml 中 llm-pi-ai.providers.*.apiKeyEnv 引用的变量名

# B.AI (bai) — DeepSeek V4 Flash 等
BAI_API_KEY=

# OpenCode Go (opencode-go) — minimax-m3 / qwen3.7-max / kimi-k2.6 等
OPENCODE_GO_API_KEY=

# OpenCode (opencode) — 免费模型池
OPENCODE_API_KEY=

# 本地 vLLM (dgx-spark-vllm / dgx-spark-qwen-vl / dgx-spark-qwen27b)
# 本地服务一般用占位值即可
DGX_SPARK_VLLM_API_KEY=local

# ============ dsh 桌面版相关 ============
# DSH_HOME（可选）: 覆盖 dsh 用户目录（默认 %USERPROFILE%\.dsh）

# ============ 其他 (按需) ============
# AGENTOS_CHROME_CONFIG: chrome-faithful 的 Chrome 配置（若有）
# CHROME_FAITHFUL_OCR_BACKEND / CHROME_FAITHFUL_PYTHON: chrome-faithful OCR 相关
# CHROME_FAITHFUL_PPOCR_DET_MODEL_DIR / CHROME_FAITHFUL_PPOCR_REC_MODEL_DIR: PaddleOCR 模型目录

# ============ 可选代理 ============
# HTTPS_PROXY / HTTP_PROXY: 若需代理访问 api.b.ai 等
