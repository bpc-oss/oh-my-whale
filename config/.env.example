# oh-my-whale — 环境变量清单
# 新机部署时按此清单设置环境变量（值不进入 repo）
# 设置方式（PowerShell）: [Environment]::SetEnvironmentVariable('NAME', 'value', 'User')

# ============ 安装路径 ============
# 本地插件快照 copy 到这里（默认 %USERPROFILE%\ai-files）。
# bootstrap 会在 pnpm install 前把 plugins/standalone/* 复制到该目录。
OMW_PLUGIN_SOURCES_DIR=%USERPROFILE%\ai-files
# 反代监听地址；留空则自动探测第一个非虚拟网卡的私网 IPv4。
DSH_LISTEN_HOST=
# 可选：Tailscale hostname（只写主机名，不带 https://）。
TAILSCALE_HOST=
# 本地 OpenAI-compatible vLLM 入口；不要保留作者机器地址。
DSH_LOCAL_VLLM_BASE_URL=http://127.0.0.1:8888/v1
# dgx-spark-deepseek-v41 使用的第二个本地端口（没有就填同一个地址）。
DSH_LOCAL_VLLM_DEEPSEEK_BASE_URL=http://127.0.0.1:8899/v1

# ============ dsh 模型 provider 的 API Key ============
# profile/cordis.patch.yml.template 中 llm-pi-ai.providers.*.apiKeyEnv 引用的变量名

# B.AI (bai)
BAI_API_KEY=
# OpenCode (opencode) 免费模型池
OPENCODE_API_KEY=
# TeamoRoute / TM
TEAMOROUTE_API_KEY=
TM_API_KEY=
# TokenRouter
TOKENROUTER_API_KEY=
# Z.AI Coding CN
ZAI_CODING_CN_API_KEY=
# CommandCode
COMMANDCODE_API_KEY=
# StepFun
STEPFUN_API_KEY=
# 云之声 / YZS
YZS_API_KEY=
# supergpt 系列中转
LAOBAZHONGZHUANG_API_KEY=
LAOBAGUOMO_API_KEY=
LAOBACC_API_KEY=
# 纪元 / tokenrhythm
JIYUAN_API_KEY=
# 本地 vLLM 一般用占位值即可
DGX_SPARK_VLLM_API_KEY=local

# ============ dsh 桌面版相关 ============
# DSH_HOME（可选）: 覆盖 dsh 用户目录（默认 %USERPROFILE%\.dsh）

# ============ 其他 (按需) ============
# AGENTOS_CHROME_CONFIG: chrome-faithful 的 Chrome 配置（若有）
# CHROME_FAITHFUL_OCR_BACKEND / CHROME_FAITHFUL_PYTHON: chrome-faithful OCR 相关
# CHROME_FAITHFUL_PPOCR_DET_MODEL_DIR / CHROME_FAITHFUL_PPOCR_REC_MODEL_DIR: PaddleOCR 模型目录

# ============ 可选代理 ============
# HTTPS_PROXY / HTTP_PROXY: 若需代理访问 api.b.ai 等
