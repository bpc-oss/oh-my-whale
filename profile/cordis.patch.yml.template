# ── Agent Team roster capacity (2026-10-20) ────────────────────────────────
# Bundle default is maxMembers: 8. Roster rows are IMMUTABLE journal entries that
# are never reclaimed (including failed ones), so 8 capped team-mode dispatches to
# 8 per Lead conversation. Raised to the JS safe-integer ceiling: a profile-layer
# override REPLACES the whole config, so every sibling field is restated.
- id: agent-team
  config:
    maxMembers: 9007199254740991
    maxTasks: 256
    maxMessageBytes: 65536
    disposalTimeoutMs: 5000
