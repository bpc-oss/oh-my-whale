# 2026-09-29 硬禁用：用正确的行 id 阻断 bundle patch 自装配（super-injector 写的 id 是包名，不匹配）
- id: vision-toolkit
  # 2026-09-30: the DSH 2.0.16 import dropped the provider override that the
  # 2026-09-29 change made. Restored so that re-enabling the plugin can never fall
  # back to a public cloud VLM (vLLM default = https://api.inferera.com/v1,
  # gemini-3.6-flash), which would upload every image off-box.
  config:
    provider:
      credential: DGX_SPARK_VLLM_API_KEY
      baseUrl: {{LOCAL_VLLM_BASE_URL}}
      model: GLM-5.3-Flash-EXL3
    language: zh
    timeoutMs: 180000
  disabled: true
# P0-1 verification 插件（2026-08-20 重构：全局引擎移除，只保留客户端）。
# 引擎改为只在 enforce-standard preset 挂载（enforce 模式）——其他会话零验证开销。
# 客户端保持全局：仅在会话有验证状态时渲染 UI（无引擎的会话无状态、无 UI）。
- insert:
    # P0-1 verification 插件：引擎全局（advisory）+ 客户端。
    # 引擎按 session.header.agentPreset 激活 enforce（modeOf），enforce-standard 会话进 enforce。
    # 其他会话保持 advisory 不拦截（仅记录；不调用验证工具时无状态写入）。
- insert:
    - id: bpc-verification-engine
      name: "@bpc-oss/dsh-verification"
      config:
        mode: advisory
        intent:
          provider: bai
          model: deepseek-v4-flash
- insert:
    - id: bpc-verification-client
      name: "@bpc-oss/dsh-client-ui-verification"
# 手机远程访问（2026-08-16 配置）：Tailscale Serve 把 127.0.0.1:<web端口>
# 暴露为 https://{{TAILSCALE_HOST}}（仅 tailnet 内可访问）。
# /api 信任围栏按 Host 放行；web-runtime 行把受信 authority 并入 webRuntime.trustedHosts，
# connection 行已引用该值（无端口=匹配任意端口）。
# 注意：js-yaml 不支持 !!js 直接作用在流式数组上，须用带引号的整体 js 表达式。
# 撤销远程访问时删除本块，并执行：tailscale serve reset
- id: web-runtime
  config:
    printUrl: true
    surfaceContext: true
    trustedHosts:
      - localhost
      - 127.0.0.1
      - {{TAILSCALE_HOST}}
# 反代入口（dsh-full-remote）：监听局域网 IP:41180，把请求鉴权后
# 重写 Host/Origin 为 127.0.0.1 再转给内核 Web（特权 API 因此远程可用），
# 并附带 gzip（首屏约 1.29MB→351KB）与哈希资源长缓存。
# 手机经路由器端口映射访问 http://<公网IP>:41180/?token=…（token 在面板里）。
# 端口说明：45120~48120 段被 winnat 隐性保留（绑定报 EADDRINUSE 但 netstat 无人监听），
# 故用实测可绑的 41180。启动/停止与改监听地址：设置 → 反向代理。
# 撤销请删本块并移除防火墙规则 “DSH Reverse Proxy Inbound (41180)”。
- id: reverse-proxy
  disabled: true
  config:
    listenHost: {{DSH_LISTEN_HOST}}
    listenPort: 41180
# Local 0.2 Connection authentication compatibility; original plugin retained for rollback.
- insert:
    - id: reverse-proxy-authfix-v2
      name: file:///{{PLUGIN_SOURCES_DIR}}/dsh-full-remote/lib/index-authfix-v2.js
      config:
        listenHost: {{DSH_LISTEN_HOST}}
        listenPort: 41180
- insert:
    - id: token-meter-hermes
      name: dsh-token-meter-hermes
      config:
        imageTokenCost: 1500

# 全局 Skills 工具：所有启用 preset/对话统一获得 skill_search / skill_load
# 注意：文件入口必须用 file:// URL；employee-ops 等 worker preset 默认禁用
# 研究编排 + 知识内化（M1 最小闭环）：research_orchestrator + knowledge_ingest
# 注意：文件入口必须用 file:// URL
# 2026-08-18：用户已授予 full access——verifyOnInstall:false 将未验证安装类命令从 T3-ask 降为 T2 直接放行。
# 2026-08-31 零感知 v2：严格 6 字段，本地回环会话直接可用；真实外部副作用仍走普通 DSH 审批。
# 旧 v1 字段、Windows Hello、WebAuthn 与原生认证 helper 已从发布包删除。
- id: continuous-worker
  disabled: true
  config:
    enabled: true
    databasePath: '{{DSH_USER_HOME}}/data/continuous-worker-v2/control.sqlite3'
    origin: 'http://127.0.0.1:0'
    instanceId: 'dsh-desktop-web'
    cleanupOwner: 'dsh-desktop-web-cleanup'
    policyPath: '{{DSH_USER_HOME}}/policies/continuous-worker-v2.json'

# 已卸载插件（@dsh-external/test-run-plugin）：disabled 阻断其 bundle patch 自装配
- id: test-run-plugin
  disabled: true

# Agent OS LCO adapter — REMOVED 2026-09-30 on the user's instruction ("lco 不要了").
# It had been parked with disabled: true since 2026-09-10. The block is gone, not merely
# disabled, so a future render or replay cannot resurrect it. That also puts the
# native-admission path out of scope: its pointer/snapshot material lived under
# AgentOS/dsh/native-admission, part of the same LCO evidence tree.

# 2026-08-20 v2.0.1 compatibility: chrome-faithful-mcp MCP spawn fails on new shell (Electron main process)
# failOnStartupError: false makes it warn/retry instead of fatal boot.
- id: chrome-faithful-mcp
  config:
    serverName: chrome_faithful
    transport: stdio
    command: !!js process.execPath
    args:
      - !!js >-
        process.getBuiltinModule('node:module').createRequire(baseUrl).resolve('@bpc-oss/dsh-plugin-chrome-faithful/mcp-server')
    env: !!js >-
      ({ ...Object.fromEntries(['AGENTOS_CHROME_CONFIG',
      'CHROME_FAITHFUL_PYTHON', 'CHROME_FAITHFUL_PPOCR_DET_MODEL_DIR',
      'CHROME_FAITHFUL_PPOCR_REC_MODEL_DIR', 'CHROME_FAITHFUL_VLM_BACKEND',
      'CHROME_FAITHFUL_OCR_BACKEND'].flatMap((key) => typeof process.env[key]
      === 'string' ? [[key, process.env[key]]] : [])), ELECTRON_RUN_AS_NODE: '1'
      })
    toolCallTimeoutMs: 60000
    failOnStartupError: false
- id: agent-os-dsh-governance
  config:
    enabled: true
    # A plugin go-live (2026-08-22): advisory observation; completion submitter lazy-connects to C watcher
    clientActivation: {{LOCAL_APP_DATA}}/AgentOS/framework-governance/state/client-activation.json
