# Your patch layer for this dsh profile, applied after every bundle layer:
# a top-level YAML array of loader patch entries (id-targeted config
# overrides, disables, and insert lists; `!!js` expressions allowed).
# v209-era rebuild (2026-09-11, from live ~/.dsh/profiles/web/cordis.patch.yml):
# - trustedHosts 静态化：v209 桌面壳静态校验拒 !!js（见 web-runtime 块注释）。
# - A5：agentos-dsh-lco 已于 2026-09-30 按用户指示移除（不再 merely disabled）。
# - continuous-worker：当前 disabled（v2 冻结在 ~/.dsh/releases/continuous-worker-v2/<hash>，
#   启用时删 disabled 行并按发布目录核对 databasePath/policyPath）。
# - 本模板止于 governance 块；其后的 '#Managed by dsh-plugin-manager...' 行是装机期
#   dsh-plugin-manager 自动追加的运行态，不入模板。
#
# dsh-web-billing 已作为 bundle 安装（见 package.json 的 dsh.profile.bundles），
# 其自带 cordis.patch.yml 提供默认配置，本层无需重复 insert。
# 如需覆盖其配置，按 id 覆写整行即可（覆盖会替换整份 config）：
#
# - id: web-billing
#   config:
#     currency: CNY
#     symbol: '¥'
#     displayCurrency: auto
#     # 注意：给某个模型配置 prices 会「冻结」该模型价格（覆盖官方政策，含峰谷），一般不需要。
#     # prices:
#     #   my-custom-model: { input: 1, cacheRead: 0.05, output: 2 }
#     # policyOverrides:
#     #   - since: '2026-09-01T00:00:00+08:00'
#     #     label: 示例
#     #     prices:
#     #       deepseek-v4-flash: { input: 5, cacheRead: 0.1, output: 10 }
# 本地模型按官方价计费（省了多少钱）：localProviders 里的 provider 按官方价格表计算
# 名义价值，实际成本按 localCostPerM（默认 0 = 免费），差值计入「已节省」。
- id: web-billing
  config:
    currency: CNY
    symbol: '¥'
    symbolUsd: '$'
    displayCurrency: auto
    localProviders:
      - dgx-spark-vllm
      - dgx-spark-qwen-vl
    # 2026-08-20 降载：默认 maxRecent=100000 导致 detail 账本 52MB、30s 全量序列化
    # 卡事件循环（宿主死循环诱因之一）。20000 条 ≈ 满足常规对账，滚剪不丢统计聚合。
    maxRecent: 20000
    maxMessagesPerSession: 500
    # 明细文件防抖写间隔 ms（默认 30000）。调大到 60000 进一步降写频率；
    # 明细在内存全量，仅落盘更慢（掉电最多丢 60s 明细，统计聚合不丢）。
    detailWriteIntervalMs: 60000
    # 2026-08-24 新架构：流式重放（低内存）+ 会话集共识文件（远离空转）+ 空结果防呆 + 失败不崩。
    # 每次重启自动对账：从 DSH 会话源重建为完整历史；对账完成后按冻结窗口（7 天）自动封账。
    # [2026-08-26 rc.2 紧急修复] reconcileOnStartup 在有大账本时同步全量重放 11 万事件，
    # 阻塞主线程 20+ 分钟导致应用"卡死"。关闭启动对账：账单靠实时 record 累计（不丢数据），
    # 存量账本保留；需重建时可手动 POST /billing/reconcile 或临时改回 true。
    # 2026-08-26 v2.5.2：分片异步化（逐帧/行批让出 + 进度日志 + 202 后台）不再阻塞主线程，
    # 每次重启自动对账：从 DSH 会话源重建完整历史；对账完成后按冻结窗口（7 天）自动封账。
    # [2026-08-28 结论] O(n^2) 裁剪已打补丁（lib/index.js 批量裁剪，179s→43s）但大文件
    # （63MB→177MB 文本）单文件处理仍同步阻塞主线程（240→250 卡 2min+，HTTP 无响应）。
    # 需作者将 scan 解压/解析 worker 化。此配置保持 false；修复后可手动 POST /billing/reconcile。
    reconcileOnStartup: false
    # 2026-08-31 缩减/降频（治「用久了卡」）：明细驻留 2 天（聚合完整保留，逐条展示窗口变小）、
    # 核心聚合写盘 1s→5s（写盘频率与卡顿摊薄 5 倍）。
    detailRetentionDays: 2
    coreWriteIntervalMs: 5000
    # localCostPerM: 0        # 本地实际单价（¥/1M，默认 0；可填电费/算力成本）
    # 2026-08-20 卡顿优化（§1 首选）：session-projection-cache 每 5s/200 事件全量重写
    # 26MB projcache，7 活跃会话 → 每 5s 最多 7 次整文件写（~36MB/s）占满事件循环。
    # 覆盖为 30s/500 事件：6 倍降载；projcache 是投影缓存（源数据 session.jsonl.zstd
    # 永在），崩溃最多丢最后 30s 缓存，coldSnapshot 自动从持久层重建，质量零丢。
- id: session-projection-cache
  config:
    writeEveryEvents: 5000
    writeIntervalMs: 30000
# 20260929 卸载遗留外部视觉工具链（原生 read_image 取代）。回滚=删掉下面每行的 '# ' 前缀。
# 注意：super-injector 写的 id 是包名 dsh-vision-toolkit，拦不住 bundle patch；
# 必须用行 id vision-toolkit 才能真正阻断自装配。
# - id: vision-toolkit
#   config:
#     provider:
#       baseUrl: http://127.0.0.1:18005/v1
#       credential: DGX_SPARK_VLLM_API_KEY
#       model: Qwen/Qwen3-VL-2B-Instruct
#     language: zh
#     timeoutMs: 180000
#     maxImageBytes: 10485760
#     maxImagePixels: 40000000
#     concurrency: 1
#     runtime:
#       mode: managed
#       python: '{{USER_HOME}}\AppData\Roaming\uv\python\cpython-3.12-windows-x86_64-none\python.exe'
#     allowedDirs: []
- id: vision-toolkit
  # The plugin stays uninstalled, but its provider override is kept HERE on purpose:
  # if it is ever re-enabled, the toolkit's own vLLM default is a PUBLIC cloud
  # endpoint (https://api.inferera.com/v1, gemini-3.6-flash), which would upload
  # every image off-box. Pinning it to the on-box GLM-5.3 endpoint makes that
  # impossible. Losing this block on a replay is a privacy regression, not a
  # cosmetic one — keep it in sync with profiles/web/cordis.patch.yml.
  config:
    provider:
      credential: DGX_SPARK_VLLM_API_KEY
      baseUrl: http://192.168.31.221:8888/v1
      model: GLM-5.3-Flash-EXL3
    language: zh
    timeoutMs: 180000
  disabled: true
# P0-1 verification 插件（2026-08-20 重构：全局引擎移除，只保留客户端）。
# 引擎改为只在 enforce-standard preset 挂载（enforce 模式）——其他会话零验证开销。
# 客户端保持全局：仅在会话有验证状态时渲染 UI（无引擎的会话无状态、无 UI）。
- insert:
    # P0-1 verification 插件：引擎全局（advisory）+ 客户端。
    # 引擎按 session.header.agentPreset 激活 enforce（modeOf），enforce-standard 会话进 enforce。
    # 其他会话保持 advisory 不拦截（仅记录；不调用验证工具时无状态写入）。
- insert:
    - id: bpc-verification-engine
      name: "@bpc-oss/dsh-verification"
      config:
        mode: advisory
        intent:
          provider: bai
          model: deepseek-v4-flash
- insert:
    - id: bpc-verification-client
      name: "@bpc-oss/dsh-client-ui-verification"
# 手机远程访问（2026-08-16 配置）：Tailscale Serve 把 127.0.0.1:<web端口>
# 暴露为 https://{{TAILSCALE_HOST}}（仅 tailnet 内可访问）。
# /api 信任围栏按 Host 放行；受信 authority 静态并入 webRuntime.trustedHosts（无端口=匹配任意端口）。
# v209 起必须写静态列表：桌面壳的静态配置校验拒绝 !!js 表达式（旧的 !!js 合并 ctx.webStartup.trustedHosts
# 写法会被拒装载）——这就是本文件 trustedHosts 静态化的原因（2026-09-11 v209 迁移定稿）。
# 撤销远程访问时删除 tailnet 行，并执行：tailscale serve reset
- id: web-runtime
  config:
    printUrl: true
    surfaceContext: true
    trustedHosts:
      - localhost
      - 127.0.0.1
      - {{TAILSCALE_HOST}}
# dsh-voice-input 语音输入插件（本地离线识别模型目录；覆盖 bundle 层默认值。
# 撤销时删除本块即可回退到「浏览器识别」模式）。
- id: voice
  config:
    engine: auto
    modelDir: '{{USER_HOME}}/dsh-voice-input/dsh-voice-models'
    asrDir: 'asr-zh'
    vadThreshold: 0.3
    tailPadSeconds: 0.6
    hotkey: 'ctrl+space'
    lang: auto
    autoSend: false
    punct: smart
# dsh-token-meter-hermes：Hermes 风格上下文分解投影（contextBreakdownHermes），
# CJK 密度感知估算 + 图片 flat cost + 8 类 breakdown。不碰 token-meter 现有投影。
# 撤销时删除本块即可（package.json 依赖可留可删）。
- insert:
    - id: token-meter-hermes
      name: dsh-token-meter-hermes
      config:
        imageTokenCost: 1500

# 全局 Skills 工具：所有启用 preset/对话统一获得 skill_search / skill_load
# 注意：文件入口必须用 file:// URL；employee-ops 等 worker preset 默认禁用
# 研究编排 + 知识内化（M1 最小闭环）：research_orchestrator + knowledge_ingest
# 注意：文件入口必须用 file:// URL
# 2026-08-18：用户已授予 full access——verifyOnInstall:false 将未验证安装类命令从 T3-ask 降为 T2 直接放行。
# 2026-08-31 零感知 v2：严格 6 字段，本地回环会话直接可用；真实外部副作用仍走普通 DSH 审批。
# 旧 v1 字段、Windows Hello、WebAuthn 与原生认证 helper 已从发布包删除。
- id: continuous-worker
  disabled: true
  config:
    enabled: true
    databasePath: '{{DSH_USER_HOME}}/data/continuous-worker-v2/control.sqlite3'
    origin: 'http://127.0.0.1:0'
    instanceId: 'dsh-desktop-web'
    cleanupOwner: 'dsh-desktop-web-cleanup'
    policyPath: '{{DSH_USER_HOME}}/policies/continuous-worker-v2.json'

# 已卸载插件（@dsh-external/test-run-plugin）：disabled 阻断其 bundle patch 自装配
- id: test-run-plugin
  disabled: true
# Inbound reverse proxy (the phone connects here). listenHost is machine-specific and
# resolved at render time — see {{DSH_LISTEN_HOST}} in scripts/template-render.ps1.
# listenPort 41180 is NOT a default: 45120-48120 is partly reserved on this box, where
# binding reports EADDRINUSE with nothing listening in netstat, so 41180 was chosen by
# measurement. Change the listen address from the app: 设置 -> 反向代理.
# To undo: delete this block and remove the firewall rule "DSH Reverse Proxy Inbound (41180)".
- id: reverse-proxy
  config:
    listenHost: {{DSH_LISTEN_HOST}}
    listenPort: 41180


# Agent OS LCO adapter — REMOVED 2026-09-30 on the user instruction ("lco 不要了").
# Had been parked with disabled: true since 2026-09-10; the block is now gone so a replay
# cannot resurrect it. The native-admission path goes with it: its pointer/snapshot
# material lived under AgentOS/dsh/native-admission, part of the same LCO evidence tree.


# 2026-08-20 v2.0.1 compatibility: chrome-faithful-mcp MCP spawn fails on new shell (Electron main process)
# failOnStartupError: false makes it warn/retry instead of fatal boot.
- id: chrome-faithful-mcp
  config:
    serverName: chrome_faithful
    transport: stdio
    command: !!js process.execPath
    args:
      - !!js >-
        process.getBuiltinModule('node:module').createRequire(baseUrl).resolve('@bpc-oss/dsh-plugin-chrome-faithful/mcp-server')
    env: !!js >-
      ({ ...Object.fromEntries(['AGENTOS_CHROME_CONFIG',
      'CHROME_FAITHFUL_PYTHON', 'CHROME_FAITHFUL_PPOCR_DET_MODEL_DIR',
      'CHROME_FAITHFUL_PPOCR_REC_MODEL_DIR', 'CHROME_FAITHFUL_VLM_BACKEND',
      'CHROME_FAITHFUL_OCR_BACKEND'].flatMap((key) => typeof process.env[key]
      === 'string' ? [[key, process.env[key]]] : [])), ELECTRON_RUN_AS_NODE: '1'
      })
    toolCallTimeoutMs: 60000
    failOnStartupError: false
- id: agent-os-dsh-governance
  config:
    enabled: true
    # A plugin go-live (2026-08-22): advisory observation; completion submitter lazy-connects to C watcher
    clientActivation: {{LOCAL_APP_DATA}}/AgentOS/framework-governance/state/client-activation.json

# 2.0.9 官方右侧栏与 better-sidebar 功能重复——用户决定 2026-09-12：保留 better-sidebar。
# ui-sidebar-right 必须保留：dsh-client-ui-chat 的 dsh.client.inject 引用它，整禁会 renderer boot fail
# （实测 renderer boot failed (plugins: @deepseek-ai/dsh-client-ui-chat)）。
# 右侧栏重复展开按钮由内核补丁 P31 隐藏（sidebar-right client.js ExpandButton 恒返 null，见 patches/manifest.json）。
# ui-sidebar-files（Explorer 文件树 tab）与 better-sidebar 的文件树重复 → 禁用。
# ui-sidebar-documentpreview（文件/图片预览 tab）不禁！它认领 dsh-resource://file/** pattern，聊天里点
# 图片/文件预览依赖它；2026-09-12 曾误禁，报 "sidebarRight: no registered tab type claims <url>" 后恢复。
- id: ui-sidebar-files
  disabled: true

# 已卸载插件（@dsh-external/dsh-vision-toolkit）：disabled 阻断其 bundle patch 自装配。
# 与上面的 `- id: vision-toolkit` 并存：前者拦 bundle patch，后者拦 super-injector 的包名 id 自装配。
- id: dsh-vision-toolkit
  disabled: true
