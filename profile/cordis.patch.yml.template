# oh-my-whale portable profile patch template.
#
# Snapshot source: the live ~/.dsh/profiles/web/cordis.patch.yml on 2026-10-20.
# Normalized so a second machine can render it with scripts/template-render.ps1.
#
# Machine-specific placeholders (resolved by the renderer):
#   USER_HOME                      - C:/Users/<you>
#   DSH_USER_HOME                  - USER_HOME/.dsh
#   LOCAL_APP_DATA                 - USER_HOME/AppData/Local
#   PLUGIN_SOURCES_DIR             - where bootstrap copies plugins/standalone/*
#   DSH_LISTEN_HOST                - LAN address for the inbound reverse proxy
#   TAILSCALE_HOST                 - optional tailnet hostname
#   LOCAL_VLLM_BASE_URL            - local OpenAI-compatible vLLM endpoint (default :8888)
#   LOCAL_VLLM_DEEPSEEK_BASE_URL   - second local endpoint used by dgx-spark-deepseek-v41 (default :8899)
#
# This file intentionally carries the complete model/provider catalog, permission presets,
# default model/preset selection, plugin toggles, web/billing/search settings and the
# reverse-proxy/authfix entries. Earlier snapshots stopped at the governance row and lost
# the whole provider/model section on replay.
# Your patch layer for this dsh profile, applied after every bundle layer:
# a top-level YAML array of loader patch entries (id-targeted config
# overrides, disables, and insert lists; `!!js` expressions allowed).
#
# dsh-web-billing 已作为 bundle 安装（见 package.json 的 dsh.profile.bundles），
# 其自带 cordis.patch.yml 提供默认配置，本层无需重复 insert。
# 如需覆盖其配置，按 id 覆写整行即可（覆盖会替换整份 config）：
#
# - id: web-billing
#   config:
#     currency: CNY
#     symbol: '¥'
#     displayCurrency: auto
#     # 注意：给某个模型配置 prices 会「冻结」该模型价格（覆盖官方政策，含峰谷），一般不需要。
#     # prices:
#     #   my-custom-model: { input: 1, cacheRead: 0.05, output: 2 }
#     # policyOverrides:
#     #   - since: '2026-09-01T00:00:00+08:00'
#     #     label: 示例
#     #     prices:
#     #       deepseek-v4-flash: { input: 5, cacheRead: 0.1, output: 10 }
# 本地模型按官方价计费（省了多少钱）：localProviders 里的 provider 按官方价格表计算
# 名义价值，实际成本按 localCostPerM（默认 0 = 免费），差值计入「已节省」。
- id: web-billing
  config:
    currency: CNY
    symbol: '¥'
    symbolUsd: '$'
    displayCurrency: auto
    localProviders:
      - dgx-spark-vllm
      - dgx-spark-qwen-vl
    # 2026-08-20 降载：默认 maxRecent=100000 导致 detail 账本 52MB、30s 全量序列化
    # 卡事件循环（宿主死循环诱因之一）。20000 条 ≈ 满足常规对账，滚剪不丢统计聚合。
    maxRecent: 20000
    maxMessagesPerSession: 500
    # 明细文件防抖写间隔 ms（默认 30000）。调大到 60000 进一步降写频率；
    # 明细在内存全量，仅落盘更慢（掉电最多丢 60s 明细，统计聚合不丢）。
    detailWriteIntervalMs: 60000
    # 2026-08-24 新架构：流式重放（低内存）+ 会话集共识文件（远离空转）+ 空结果防呆 + 失败不崩。
    # 每次重启自动对账：从 DSH 会话源重建为完整历史；对账完成后按冻结窗口（7 天）自动封账。
    # [2026-08-26 rc.2 紧急修复] reconcileOnStartup 在有大账本时同步全量重放 11 万事件，
    # 阻塞主线程 20+ 分钟导致应用"卡死"。关闭启动对账：账单靠实时 record 累计（不丢数据），
    # 存量账本保留；需重建时可手动 POST /billing/reconcile 或临时改回 true。
    # 2026-08-26 v2.5.2：分片异步化（逐帧/行批让出 + 进度日志 + 202 后台）不再阻塞主线程，
    # 每次重启自动对账：从 DSH 会话源重建完整历史；对账完成后按冻结窗口（7 天）自动封账。
    # [2026-08-28 结论] O(n^2) 裁剪已打补丁（lib/index.js 批量裁剪，179s→43s）但大文件
    # （63MB→177MB 文本）单文件处理仍同步阻塞主线程（240→250 卡 2min+，HTTP 无响应）。
    # 需作者将 scan 解压/解析 worker 化。此配置保持 false；修复后可手动 POST /billing/reconcile。
    reconcileOnStartup: false
    # 2026-08-31 缩减/降频（治「用久了卡」）：明细驻留 2 天（聚合完整保留，逐条展示窗口变小）、
    # 核心聚合写盘 1s→5s（写盘频率与卡顿摊薄 5 倍）。
    detailRetentionDays: 2
    coreWriteIntervalMs: 5000
    # localCostPerM: 0        # 本地实际单价（¥/1M，默认 0；可填电费/算力成本）
    # 2026-08-20 卡顿优化（§1 首选）：session-projection-cache 每 5s/200 事件全量重写
    # 26MB projcache，7 活跃会话 → 每 5s 最多 7 次整文件写（~36MB/s）占满事件循环。
    # 覆盖为 30s/500 事件：6 倍降载；projcache 是投影缓存（源数据 session.jsonl.zstd
    # 永在），崩溃最多丢最后 30s 缓存，coldSnapshot 自动从持久层重建，质量零丢。
- id: session-projection-cache
  config:
    writeEveryEvents: 5000
    writeIntervalMs: 30000
# 2026-09-29 卸载遗留外部视觉工具链（改用原生 read_image）。回滚=去掉下面每行的 '# ' 前缀。
# - id: vision-toolkit
#   config:
