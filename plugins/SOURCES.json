{
  "version": "1",
  "notes": "plugin sources inventory. install_type maps to package.json specifier: vendor-archive->file:vendor-archives/<tgz>; link->link:<path>; file-dir->file:<path>; github->github:<org>/<repo>#<ref>; npm->semver; local-tgz->file:<abs>",
