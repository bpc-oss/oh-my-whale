      "repo": "omdsh-dev/dsh-genui",
      "ref": "main",
      "package_spec": "github:omdsh-dev/dsh-genui",
      "install_type": "github",
      "description": "Generate UI"
    },
    {
      "id": "dsh-bash-terminal",
      "type": "npm",
      "version": "^0.3.11",
      "package_spec": "^0.3.11",
      "install_type": "npm",
      "description": "Bash terminal"
    },
    {
      "id": "dsh-better-sidebar",
      "type": "vendor",
      "source": "profile/vendor/dsh-better-sidebar-0.12.2-fix108.tgz",
