      "description": "Background continuous worker (local git, no remote)"
    },
    {
      "id": "dsh-plugin-manager",
      "type": "npm",
      "version": "^0.1.0",
      "package_spec": "^0.1.0",
      "install_type": "npm",
      "description": "Plugin manager"
    },
    {
      "id": "dsh-routed-subagent",
      "type": "standalone",
      "path": "plugins/standalone/dsh-routed-subagent",
      "package_spec": "link:{{PLUGIN_SOURCES_DIR}}/dsh-routed-subagent",
      "install_type": "link",
      "description": "Routed subagent (bpc-oss github, local clone)"
    },
    {
      "id": "dsh-token-meter-hermes",
      "type": "standalone",
      "path": "plugins/standalone/dsh-token-meter-hermes",
      "package_spec": "file:{{USER_HOME}}/dsh-token-meter-hermes",
      "install_type": "file-dir",
      "description": "Token meter Hermes style"
    },
    {
      "id": "dsh-voice-input",
      "type": "standalone",
      "path": "plugins/standalone/dsh-voice-input",
      "package_spec": "link:{{USER_HOME}}/dsh-voice-input",
      "install_type": "link",
      "description": "Voice input (models dir separate)"
    }
  ]
}
