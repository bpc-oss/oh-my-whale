      "description": "Code lens (currently disabled in plugin-management state)"
    },
    {
      "id": "@liustack/modsearch",
      "type": "npm",
      "version": "^5.3.0",
      "package_spec": "^5.3.0",
      "install_type": "npm",
      "description": "Search (currently disabled in plugin-management state)"
