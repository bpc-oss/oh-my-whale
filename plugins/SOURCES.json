    {
      "id": "@agentos/dsh-lco",
      "type": "local",
      "source": "{{AGENT_OS_DIR}}/dsh/bundles/agentos-dsh-lco-0.1.0.tgz",
      "package_spec": "file:{{AGENT_OS_DIR}}/dsh/bundles/agentos-dsh-lco-0.1.0.tgz",
      "install_type": "file-dir",
      "description": "Agent OS LCO adapter (local tgz in AgentOS bundles dir)"
    },
    {
      "id": "@bpc-oss/dsh-client-ui-verification",
      "type": "vendor",
      "source": "profile/vendor/bpc-oss-dsh-client-ui-verification-1.0.0-9e59c586.tgz",
      "package_spec": "file:vendor-archives/bpc-oss-dsh-client-ui-verification-1.0.0-9e59c586.tgz",
      "install_type": "vendor-archive",
      "description": "Verification client UI"
    },
    {
      "id": "@bpc-oss/dsh-evidence",
      "type": "vendor",
      "source": "profile/vendor/bpc-oss-dsh-evidence-1.0.0-355cd8ca.tgz",
      "package_spec": "file:vendor-archives/bpc-oss-dsh-evidence-1.0.0-355cd8ca.tgz",
      "install_type": "vendor-archive",
      "description": "Evidence package (schema lives here!)"
    },
    {
      "id": "@bpc-oss/dsh-plugin-chrome-faithful",
      "type": "local",
      "source": "{{CHROME_FAITHFUL_DIR}}/packages/dsh-plugin-chrome-faithful",
      "package_spec": "file:{{CHROME_FAITHFUL_DIR}}/packages/dsh-plugin-chrome-faithful",
      "install_type": "file-dir",
      "description": "Chrome automation (clone from github bpc-oss/chrome-faithful)"
    },
    {
      "id": "@bpc-oss/dsh-verification",
      "type": "vendor",
      "source": "profile/vendor/bpc-oss-dsh-verification-1.0.0-e2b031f3.tgz",
      "package_spec": "file:vendor-archives/bpc-oss-dsh-verification-1.0.0-e2b031f3.tgz",
      "install_type": "vendor-archive",
      "description": "Verification engine (enforce/advisory)"
