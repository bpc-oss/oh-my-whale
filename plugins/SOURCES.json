      "package_spec": "github:bpc-oss/litkit-search",
      "install_type": "github",
      "description": "LitKit search"
    },
    {
      "id": "@dsh-external/dsh-super-injector",
      "type": "vendor",
      "source": "profile/vendor/dsh-external-dsh-super-injector-0.3.3.tgz",
      "package_spec": "file:vendor-archives/dsh-super-injector-0.3.3.tgz",
      "install_type": "vendor-archive",
      "description": "Runtime plugin injector (REBUILT tgz includes P5 gateway gate)"
    },
    {
      "id": "@dsh-external/dsh-vision-toolkit",
      "type": "github",
      "repo": "Anionex/dsh-vision-toolkit",
      "ref": "main",
      "package_spec": "github:Anionex/dsh-vision-toolkit#main",
      "install_type": "github",
      "description": "Vision toolkit"
    },
    {
      "id": "@liustack/modlens",
      "type": "npm",
      "version": "^3.11.0",
      "package_spec": "^3.11.0",
