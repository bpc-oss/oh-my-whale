#!/usr/bin/env bash
# pre-commit: privacy scan before commit (Windows Git Bash compatible)
set -u
REPO="$(git rev-parse --show-toplevel)"

echo "=== pre-commit: privacy scan ==="
# Reuse the PowerShell scanner if available, else do a bash-level scan
if command -v powershell >/dev/null 2>&1; then
  powershell -ExecutionPolicy Bypass -File "$REPO/scripts/check-private.ps1"
  exit $?
fi

# Bash fallback scan
FAIL=0
for pat in "C:\\\\Users\\\\Administrator" "C:/Users/Administrator" "E:\\\\ai-files" "E:/ai-files" "C:\\\\ProgramData\\\\AgentOS" "sk-[a-zA-Z0-9]{16,}"; do
  if grep -rnE "$pat" "$REPO" --include="*.md" --include="*.yml" --include="*.yaml" --include="*.json" --include="*.toml" --include="*.ps1" --include="*.mjs" \
    --exclude-dir=".git" --exclude-dir="standalone" --exclude="check-private.ps1" --exclude="template-render.ps1" 2>/dev/null | grep -v "^$REPO/scripts/"; then
    echo "FAIL: '$pat' found"
    FAIL=1
  fi
done
[ $FAIL -eq 0 ] && echo "OK: no private data"
exit $FAIL
